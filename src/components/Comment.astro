---
import 'artalk/Artalk.css'
---

<div id="Comments"></div>

<script>
  import Artalk from 'artalk'
  
  document.addEventListener("astro:page-load", () => {
    Artalk.init({
      el:        '#Comments', // 挂载的 DOM 元素
      pageKey:   window.location.pathname,     // 固定链接
      pageTitle: document.title,               // 页面标题
      server:    'https://comments.meowjay.cc', // 后端地址
      site:      'Meowjay 的小窝',               // 站点名
    })
  });
</script>

